# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# Database Configuration (Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/wizard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRATION=86400

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=wizard-sandbox:latest
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TIMEOUT=300

# Blockchain Configuration (Superposition Testnet)
SUPERPOSITION_RPC_URL=https://testnet-rpc.superposition.so
SUPERPOSITION_CHAIN_ID=98985
SUPERPOSITION_EXPLORER_URL=https://testnet-explorer.superposition.so
CONTRACT_PRIVATE_KEY=your-contract-private-key
WIZARD_WALLET_ADDRESS=your-wizard-wallet-address

# Storage Configuration
STORAGE_PATH=/tmp/wizard-storage
MAX_FILE_SIZE=10485760
MAX_PROJECT_SIZE=52428800

# Crates.io API
CRATES_IO_API_URL=https://crates.io/api/v1

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000