# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRATION=86400

# Blockchain Configuration (Superposition Testnet)
SUPERPOSITION_RPC_URL=https://testnet-rpc.superposition.so
SUPERPOSITION_CHAIN_ID=98985
SUPERPOSITION_EXPLORER_URL=https://testnet-explorer.superposition.so
CONTRACT_PRIVATE_KEY=your-contract-private-key
WIZARD_WALLET_ADDRESS=your-wizard-wallet-address

# Storage Configuration
STORAGE_PATH=/tmp/wizard-storage
MAX_FILE_SIZE=10485760
MAX_PROJECT_SIZE=52428800

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Arbiscan API Keys for Contract Verification
# Get these from https://arbiscan.io/apis
ARBISCAN_API_KEY=your-arbiscan-api-key
ARBISCAN_SEPOLIA_API_KEY=your-arbiscan-api-key