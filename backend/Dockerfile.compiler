# Lightweight compiler worker image
FROM alpine:3.19

# Install Rust and compilation dependencies
RUN apk add --no-cache \
    cargo \
    rustc \
    gcc \
    musl-dev \
    git \
    bash \
    openssl-dev \
    pkgconfig \
    curl \
    # WASM tools
    binaryen \
    # Process control
    tini

# Install cargo-stylus
RUN cargo install cargo-stylus --locked && \
    cargo install wasm-opt && \
    rm -rf /usr/local/cargo/registry/* /usr/local/cargo/git/*

# Create non-root user
RUN addgroup -g 1000 compiler && \
    adduser -D -u 1000 -G compiler compiler

# Set up working directory
WORKDIR /app/projects

# Create necessary directories
RUN mkdir -p /app/cargo-cache /tmp/build-cache && \
    chown -R compiler:compiler /app /tmp/build-cache

# Switch to non-root user
USER compiler

# Environment variables
ENV CARGO_HOME=/app/cargo-cache \
    RUST_BACKTRACE=1 \
    RUSTFLAGS="-C target-cpu=native"

# Use tini as entrypoint to handle signals properly
ENTRYPOINT ["/sbin/tini", "--"]

# Default command (will be overridden by docker-compose)
CMD ["bash", "-c", "while true; do sleep 30; done"]